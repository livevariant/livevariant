{
  "name": "@livevariant/server",
  "version": "0.0.6",
  "description": "LiveVariant serving backend: Hono app with redirect/click/pixel endpoints, JS-mode choose/reward API, secret-gated stats and recompute, behind a pluggable StateStore (in-memory here; Cloudflare Durable Objects in @livevariant/workers)",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/livevariant/livevariant.git",
    "directory": "packages/server"
  },
  "keywords": [
    "ab-testing",
    "multi-armed-bandit",
    "hono",
    "redirect",
    "experimentation"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@livevariant/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@livevariant/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    }
  },
  "bin": {
    "livevariant-server": "./dist/main.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@livevariant/core": "0.0.6",
    "@livevariant/mcp": "0.0.6",
    "@livevariant/tools": "0.0.6",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hono": "^4.12.33",
    "zod": "^4.4.3"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "peerDependencies": {
    "vitest": ">=3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
