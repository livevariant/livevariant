{
  "name": "@livevariant/mcp",
  "version": "0.0.4",
  "description": "MCP server for LiveVariant: build, inspect and read bandit-driven A/B tests from Claude, ChatGPT, Copilot or any MCP client",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/livevariant/livevariant.git",
    "directory": "packages/mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ab-testing",
    "multi-armed-bandit",
    "experimentation"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@livevariant/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "livevariant-mcp": "./dist/main.js"
  },
  "dependencies": {
    "@livevariant/tools": "0.0.4",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  }
}
