{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "declaration": true,
    "forceConsistentCasingInFileNames": true,
    // Runs on Node, Workers, and browsers; the web-platform globals it
    // uses (crypto.subtle, TextEncoder, btoa) come from the dom lib
    // rather than @types/node, keeping the package runtime-neutral.
    "lib": ["es2022", "dom"],
    "types": []
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"]
}
