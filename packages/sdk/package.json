{
  "name": "@livevariant/sdk",
  "version": "0.1.3",
  "description": "SDK for LiveVariant, browser and headless (node, agents): sticky variant assignment with client-side hashing (raw ids and context never leave the client), session/local/in-memory storage modes, and zero-setup conversion tracking via Google Analytics dataLayer interception",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/livevariant/livevariant.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "ab-testing",
    "multi-armed-bandit",
    "browser",
    "node",
    "headless",
    "agents",
    "analytics",
    "experimentation"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@livevariant/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@livevariant/core": "0.1.3"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  }
}
