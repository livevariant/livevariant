{
  "name": "@livevariant/tools",
  "version": "0.0.7",
  "description": "LiveVariant's tool definitions: one registry describing every operation an assistant can perform, from which the MCP server, the REST API, the OpenAPI document and the agent SKILL are all generated",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/livevariant/livevariant.git",
    "directory": "packages/tools"
  },
  "keywords": [
    "ab-testing",
    "multi-armed-bandit",
    "mcp",
    "openapi",
    "agent-tools"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@livevariant/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@livevariant/core": "0.0.7",
    "zod": "^4.4.3"
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  }
}
