{
  "name": "@livevariant/workers",
  "version": "0.0.7",
  "description": "Cloudflare Workers deployment of the LiveVariant server: one SQLite-backed Durable Object per test as the state store",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/livevariant/livevariant.git",
    "directory": "packages/workers"
  },
  "private": true,
  "type": "module",
  "scripts": {},
  "nx": {
    "includedScripts": [],
    "targets": {
      "dev": {
        "command": "wrangler dev --env dev",
        "options": {
          "cwd": "{workspaceRoot}"
        },
        "dependsOn": [
          "^build"
        ],
        "continuous": true
      }
    }
  },
  "dependencies": {
    "@livevariant/core": "0.0.7",
    "@livevariant/server": "0.0.7",
    "@livevariant/accounts": "0.0.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "wrangler": "^4.118.0"
  }
}
