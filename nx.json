{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/src/test-setup.[jt]s"
    ],
    "sharedGlobals": []
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json",
          "buildDepsName": "build-deps",
          "watchDepsName": "watch-deps"
        }
      }
    },
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "devTargetName": "dev",
        "previewTargetName": "preview",
        "serveStaticTargetName": "serve-static",
        "typecheckTargetName": "typecheck",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test"
      }
    }
  ],
  "targetDefaults": {
    "test": {
      "dependsOn": ["^build"]
    }
  },
  "analytics": false,
  // Plain streamed logs, not the interactive terminal UI: dev runs two
  // continuous servers whose output should scroll like a log.
  "tui": { "enabled": false },
  "release": {
    "projectsRelationship": "fixed",
    "projects": [
      "@livevariant/core",
      "@livevariant/tools",
      "@livevariant/server",
      "@livevariant/mcp",
      "@livevariant/postgres",
      "@livevariant/sdk",
      "@livevariant/workers",
      "@livevariant/accounts",
      "@livevariant/web",
      "@livevariant/react"
    ],
    "version": {
      "preVersionCommand": "npx nx run-many -t build",
      "versionActionsOptions": {
        // nx's lock-file step shells out to `npm install`, and npm has a
        // standing bug (npm/cli#7961, #4828) where an install with a
        // node_modules present prunes the platform variants that machine
        // does not use. On a Mac that quietly deletes every linux entry,
        // and the release commit then fails `npm ci` on CI while looking
        // perfect locally. It cost this repo two red releases.
        //
        // A version bump does not need a resolver: the only thing that
        // legitimately changes in the lockfile is the version of each
        // workspace package and the specifiers its siblings use for it.
        // scripts/release.mjs writes exactly that, deterministically, and
        // verifies nothing was dropped.
        "skipLockFileUpdate": true
      }
    }
  }
}
