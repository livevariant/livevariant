{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "livevariant",
  "main": "packages/workers/src/index.ts",
  "compatibility_date": "2026-07-01",
  // One Durable Object per testId: single-threaded per test, so assignment
  // races and blob CAS conflicts cannot happen by construction.
  "durable_objects": {
    "bindings": [
      {
        "name": "TEST_STATE",
        "class_name": "TestStateDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TestStateDO"]
    }
  ],
  "observability": {
    "enabled": true
  },
  // Image hosting (optional at runtime): uploads at /assets, signed
  // serving at /a. The bucket alone does nothing; the feature switches on
  // when the LV_ASSET_SECRET secret is also set. Locally and in tests R2
  // is simulated, so nothing needs creating. Delete this block if you
  // want a deployment without image hosting at all.
  "r2_buckets": [
    {
      "binding": "ASSET_STORE",
      "bucket_name": "livevariant-assets"
    }
  ],
  // Offered by the Deploy to Cloudflare button, which reads them from here
  // and shows the descriptions in package.json's `cloudflare.bindings`.
  // Both are empty on purpose: empty is the correct answer for a
  // single-domain deployment, and the server treats blank as unset.
  "vars": {
    "LV_SERVE_URL": "",
    "LV_ALLOWED_DESTINATIONS": "",
    "LV_ALLOWED_ORIGINS": "",
    "LV_UNLISTED_DESTINATIONS": "",
    "LV_GOOGLE_TAG_MANAGER": "",
    "LV_PUBLISHABLE_KEY": "",
    // First-party identity cookie for id-less serve/click navigations.
    // "on" (default) or "off" for a fully cookieless deployment.
    "LV_BROWSER_ID_COOKIE": "on"
  },
  // Deliberately no routes here. This is the config a
  // stranger gets when they deploy their own copy, and it has to work on
  // their account: routes name zones only we own, and LV_SERVE_URL would
  // put OUR domain in THEIR visitors' links. Both live under env.production
  // instead, which is what the hosted deployment deploys with.
  //
  // The result for a self-hoster is one workers.dev origin serving
  // everything, with every URL built from the request itself.
  "workers_dev": true,
  // The Worker also serves the site. run_worker_first lists the paths the
  // app owns, because the single-page fallback would otherwise answer them
  // with index.html; everything else is a static file, or the app shell
  // standing in for one of its client-side routes.
  //
  // Bare and /-suffixed forms are both listed on purpose: /s and /s/:cfg
  // are the query-parameter and encoded spellings of one endpoint, and
  // "/s/*" alone would route one and not the other.
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    // "none", not "single-page-application": the router's SPA fallback
    // answers EVERY miss with index.html at 200, so /favicon.ico and
    // /sitemap_index.xml came back as HTML claiming success. Misses now
    // fall through to the Worker, which serves the shell to browser
    // NAVIGATIONS and a true 404 to everything else (see the
    // app.notFound handler in packages/server/src/app.ts).
    "not_found_handling": "none",
    "run_worker_first": [
      // The homepage runs worker-first for agents (markdown negotiation,
      // Link headers); browsers get the shell via the ASSETS binding.
      "/",
      "/auth.md",
      "/sitemap.xml",
      "/s",
      "/s/*",
      "/c",
      "/c/*",
      "/px/*",
      "/choose",
      "/reward",
      "/stats/*",
      "/recompute/*",
      "/exclude/*",
      "/auth/*",
      "/account/*",
      "/.well-known/*",
      "/llms.txt",
      "/robots.txt",
      "/skills/*",
      "/health",
      "/config",
      "/assets",
      "/a/*",
      "/api/*",
      "/mcp",
      "/openapi.json",
      "/docs"
    ]
  },
  // Our own deployment, shipped by Cloudflare Workers Builds on every push
  // to main (`npm run deploy:livevariant` by hand). Nothing here is reachable
  // by anyone deploying this repository to their own account: a bare
  // `wrangler deploy` uses the base config above, which is the point of the
  // split.
  "env": {
    // Local development WITH accounts: `npm run dev:worker` runs this env,
    // the hosted entry over a simulated local D1 (apply migrations once
    // with `npm run migrate:local`). LV_AUTH_SECRET comes from .dev.vars;
    // no Resend key means magic links print to this terminal instead of
    // sending email. Never deployed.
    "dev": {
      "main": "packages/workers/src/index.hosted.ts",
      "compatibility_flags": ["nodejs_compat"],
      "durable_objects": {
        "bindings": [
          {
            "name": "TEST_STATE",
            "class_name": "TestStateDO"
          }
        ]
      },
      "r2_buckets": [
        {
          "binding": "ASSET_STORE",
          "bucket_name": "livevariant-assets"
        }
      ],
      "d1_databases": [
        {
          "binding": "LV_ACCOUNTS_DB",
          "database_name": "livevariant-accounts",
          "database_id": "8d35e487-9220-4661-9f8f-aa5896c8ed42",
          "migrations_dir": "packages/accounts/migrations"
        }
      ],
      "vars": {
        "LV_SERVE_URL": "",
        "LV_ALLOWED_DESTINATIONS": "",
        "LV_ALLOWED_ORIGINS": "",
        "LV_UNLISTED_DESTINATIONS": "",
        "LV_GOOGLE_TAG_MANAGER": "",
        "LV_PUBLISHABLE_KEY": "",
        "LV_BROWSER_ID_COOKIE": "on",
        // The vite origin: the dashboard is developed through its proxy,
        // so cookies, CORS and magic-link callbacks all key off it.
        "LV_APP_URL": "http://localhost:5173"
      }
    },
    "production": {
      "workers_dev": false,
      // The hosted entry: base serving plus the accounts module. It
      // re-exports TestStateDO, which the durable_objects block below
      // resolves against. A bare `wrangler deploy` never touches this
      // file, so no auth framework ever reaches a self-host bundle.
      "main": "packages/workers/src/index.hosted.ts",
      // Better Auth pulls node:crypto and node:async_hooks; the compat
      // layer exists only where accounts do.
      "compatibility_flags": ["nodejs_compat"],
      // Repeated, not inherited: wrangler does NOT copy bindings down into
      // a named environment, so leaving this out deploys a Worker with no
      // state store at all.
      //
      // `migrations` above is deliberately NOT repeated: it is inheritable.
      // Two things confirm it. Wrangler warns "<key> exists at the top
      // level, but not on env.production" for every non-inheritable key it
      // finds missing, and it says that about durable_objects and nothing
      // about migrations. And livevariant-production was created from
      // scratch by `deploy --env production`, so its SQLite storage could
      // only exist if the migration had been inherited.
      "durable_objects": {
        "bindings": [
          {
            "name": "TEST_STATE",
            "class_name": "TestStateDO"
          }
        ]
      },
      // vars are not inherited, so every key from the top level has to be
      // repeated or wrangler warns. Empty means unset, same as the base.
      "r2_buckets": [
        {
          "binding": "ASSET_STORE",
          "bucket_name": "livevariant-assets"
        }
      ],
      // Accounts registry + Better Auth tables. Production-only on
      // purpose (d1_databases is not inheritable, and the base config
      // must deploy on a stranger's account with no database). Apply
      // migrations with `npm run migrate:livevariant` BEFORE deploying
      // a schema-dependent build; never automatically on push.
      "d1_databases": [
        {
          "binding": "LV_ACCOUNTS_DB",
          "database_name": "livevariant-accounts",
          "database_id": "8d35e487-9220-4661-9f8f-aa5896c8ed42",
          "migrations_dir": "packages/accounts/migrations"
        }
      ],
      "vars": {
        "LV_SERVE_URL": "https://livevariant.link",
        "LV_ALLOWED_DESTINATIONS": "",
        "LV_ALLOWED_ORIGINS": "",
        // The hosted deployment is open to strangers, so unverified
        // redirect destinations get the explicit continue screen instead
        // of making livevariant.link a one-hop open redirector.
        "LV_UNLISTED_DESTINATIONS": "interstitial",
        "LV_APP_URL": "https://livevariant.com",
        "LV_EMAIL_FROM": "LiveVariant <login@mail.livevariant.com>",
        // Our account id is not a secret; the Browser Rendering token is
        // (wrangler secret put LV_CF_BROWSER_TOKEN --env production).
        // Both present = tag-manager SDK installs verify domains too.
        "LV_CF_ACCOUNT_ID": "7f5af4cd929693e6a93795847de63fbe",
        // Fill with the GTM-XXXXXXX container id to load Google Tag
        // Manager on the dashboard pages (served via /config, injected
        // by the SPA). Committed here because deploys overwrite
        // dashboard-set vars; container ids are public.
        "LV_GOOGLE_TAG_MANAGER": "GTM-MBJGT37D",
        // Our own publishable key (from Settings), so the landing's
        // hero test registers under our org and shows in My tests.
        // Publishable keys are public by design.
        "LV_PUBLISHABLE_KEY": "pk_4h92m7urxh7to7c83eacn2e8", // gitleaks:allow
        "LV_BROWSER_ID_COOKIE": "on"
      },
      "routes": [
        { "pattern": "livevariant.link/*", "zone_name": "livevariant.link" },
        { "pattern": "livevariant.com/*", "zone_name": "livevariant.com" }
      ]
    }
  }
}
