{
  "name": "@livevariant/source",
  "version": "0.0.0",
  "license": "AGPL-3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "test:no-browser": "nx run-many -t test --exclude @livevariant/sdk,@livevariant/web",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "graph": "nx graph",
    "prepare": "husky",
    "generate": "node scripts/generate-agent-assets.mjs",
    "release": "node scripts/release.mjs",
    "release:dry": "node scripts/release.mjs --dry-run",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:livevariant": "wrangler deploy --env production",
    "versions:livevariant": "wrangler versions upload --env production"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/vite": "23.1.1",
    "@nx/vitest": "23.1.1",
    "@nx/web": "23.1.1",
    "@types/node": "^24.10.9",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "~4.1.10",
    "@vitest/ui": "~4.1.10",
    "eslint": "~10.6.0",
    "husky": "^9.1.7",
    "jiti": "2.4.2",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "^17.0.8",
    "nx": "23.1.1",
    "playwright": "^1.61.1",
    "prettier": "^3.8.1",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4",
    "vitest": "~4.1.10",
    "wrangler": "^4.118.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "nx": {
    "includedScripts": []
  },
  "cloudflare": {
    "bindings": {
      "LV_SERVE_URL": {
        "description": "Optional. Leave empty to serve everything from one domain, which is the simplest setup. Set it to a second domain if you send bulk email and want campaign links on their own hostname, so a campaign's reputation never touches your dashboard's."
      },
      "LV_ALLOWED_DESTINATIONS": {
        "description": "Optional, comma-separated hostnames. Anyone can author a test config pointing anywhere, so set this on a deployment reachable from the internet to stop yours being used as an open redirector."
      },
      "LV_ASSET_SECRET": {
        "description": "Optional. Enables image hosting (uploads at /assets, download URLs signed per serve). Generate one with `openssl rand -hex 32`. Leave empty to run without image hosting."
      }
    }
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "@radix-ui/react-tabs": "^1.1.21"
  }
}
